    "clsx": "^2.1.1",
    "framer-motion": "^12.42.0",
    "howler": "^2.2.4",
    "lucide-react": "^1.16.0",
    "next": "16.3.5",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/howler": "^2.2.12",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.5",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "wrangler": "^4.137.0"
  }
